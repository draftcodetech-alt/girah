generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────
// CATALOG
// ────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String
  category    Category           @relation(fields: [categoryId], references: [id])
  categoryId  String
  images      ProductImage[]
  variations  ProductVariation[]
  reviews     Review[]
  wishlist    WishlistItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariation {
  id               String            @id @default(cuid())
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  name             String // e.g. "Medium Bouquet"
  price            Int // stored in smallest currency unit (paisa) — never a float, per Reliability NFR
  stock            Int               @default(0)
  isEnabled        Boolean           @default(true) // admin can disable independent of stock count
  cartItems        CartItem[]
  orderItems       OrderItem[]
  stockAdjustments StockAdjustment[]

  @@index([productId])
}

// Phase 15: wishlist — one row per (user, product); both FKs cascade so a
// deleted product or account leaves no orphans. Uniqueness is the toggle's
// idempotence guarantee (a double-click races into P2002, not a dupe row).
model WishlistItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ────────────────────────────────
// ACCOUNTS
// ────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id               String            @id @default(cuid())
  role             Role              @default(CUSTOMER)
  name             String
  email            String            @unique
  passwordHash     String
  phone            String?
  isActive         Boolean           @default(true)
  // Bumped whenever existing sessions must die (account disable, password change).
  // The jwt callback compares it against the token and invalidates on mismatch.
  sessionVersion   Int               @default(0)
  savedShipping    SavedShipping?
  passwordResetTokens PasswordResetToken[]
  cart             Cart?
  orders           Order[]
  reviews          Review[]
  stockAdjustments StockAdjustment[]
  wishlist         WishlistItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// Phase 14: password reset tokens. Only the SHA-256 hash of the raw token
// is stored — a database leak must not hand out working reset links. One
// live token per user (request deletes predecessors), single-use (consumed
// on success), 1-hour expiry enforced at use time.
model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model SavedShipping {
  id         String  @id @default(cuid())
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String  @unique // one-to-one — single saved address per user
  fullName   String
  phone      String
  address    String
  city       String
  postalCode String?
}

// ────────────────────────────────
// CART
// ────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?    @unique
  guestId   String?    @unique // anonymous session identifier for guest carts
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id          String           @id @default(cuid())
  cart        Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId      String
  variation   ProductVariation @relation(fields: [variationId], references: [id])
  variationId String
  quantity    Int

  @@unique([cartId, variationId]) // enforces "same variation combines" at the DB level
}

// ────────────────────────────────
// ORDERS
// ────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  SAFEPAY
}

model Order {
  id              String  @id @default(cuid())
  orderNumber     String  @unique // e.g. "GIR-10482", generated at creation
  user            User?   @relation(fields: [userId], references: [id])
  userId          String?
  // guest snapshot — always populated, even for registered users, so the order
  // never depends on the User record surviving (a deleted account shouldn't corrupt history)
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  shippingCity    String
  shippingPostal  String?
  deliveryNotes   String?

  items    OrderItem[]
  subtotal Int
  shipping Int         @default(0) // always 0 — free shipping
  total    Int

  orderStatus   OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  // Phase 3: Safepay tracker token of the LAST checkout session created for
  // this order (checkout + every retry). Persisted with a CAS that can never
  // overwrite it after PAID, so it always identifies the payment that must be
  // refunded. The webhook also refreshes it with the authoritative
  // `data.tracker` on payment.succeeded.
  safepayTracker String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderStatus])
}

model OrderItem {
  id            String           @id @default(cuid())
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  variation     ProductVariation @relation(fields: [variationId], references: [id])
  variationId   String
  // FROZEN SNAPSHOT at purchase time — never a live lookup. This is what makes
  // price-locking real at the database level, not just an application-level promise.
  productName   String
  variationName String
  unitPrice     Int
  quantity      Int
  subtotal      Int

  @@index([orderId])
}

// ────────────────────────────────
// REVIEWS
// ────────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String       @id @default(cuid())
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  rating    Int
  text      String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  // Phase 10: one review per user per product — enforced at the DB so a
  // resubmit upserts (and re-enters moderation) instead of duplicating.
  @@unique([productId, userId])
  @@index([productId])
  @@index([status])
}

model StockAdjustment {
  id            String           @id @default(cuid())
  variation     ProductVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  variationId   String
  previousStock Int
  adjustment    Int
  newStock      Int
  reason        String
  // Phase 2: WHO made this adjustment (admin manual adjust or cancel-restock).
  // NULL only for legacy rows created before this column existed.
  adminId       String?
  admin         User?            @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@index([variationId])
  @@index([adminId])
}
